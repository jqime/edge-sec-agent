#!/usr/bin/env bash
# -*- coding: utf-8 -*-
"""
⚠️  DEPRECATED — scripts/sec-api ha sido reemplazado por src/sec_web.py (Flask+Gunicorn).

El servidor canónico es edge-sec-agent.service (Gunicorn) en 127.0.0.1:5000,
expuesto a través de Nginx reverse proxy en puerto 8443 con TLS + Basic Auth.

Uso:
  scripts/sec-api   → muestra mensaje de deprecación
  systemctl start edge-sec-agent.service  → inicia el servicio canónico
"""
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHONPATH="${REPO_DIR}/src:${PYTHONPATH:-}" exec python3 "${REPO_DIR}/src/sec_web.py" "$@"
