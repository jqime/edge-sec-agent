#!/bin/bash
PREGUNTA="$*"
if [ -z "$PREGUNTA" ]; then
    echo "Uso: sec-agent 'consulta'"
    exit 1
fi
if echo "$PREGUNTA" | grep -qiE "red|dispositivos|escanea|puertos|procesos|cpu|memoria|temp|temperatura|fallos|ssh|firewall|ufw|fail2ban|docker|actualizar|update|status|estado|kernel|logs|servicio|reiniciar"; then
    sec-chat --plan "$PREGUNTA"
else
    ia "$PREGUNTA"
fi
