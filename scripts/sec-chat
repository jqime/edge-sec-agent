#!/bin/bash
if [ "$1" = "--tool" ] && [ -n "$2" ]; then
    TOOL="/root/edge-sec-agent/mcp_tools/$2"
    shift 2
    if [ -x "$TOOL" ]; then
        exec "$TOOL" "$@"
    else
        echo "Herramienta no encontrada: $2"
        exit 1
    fi
fi
if [ "$1" = "--plan" ] && [ -n "$2" ]; then
    exec /usr/local/bin/sec-agent "$@"
fi
exec /usr/local/bin/sec-agent "$@"
