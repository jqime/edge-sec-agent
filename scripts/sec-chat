#!/bin/bash
SCRIPT_DIR="$(dirname "$0")"
if [ "$1" = "--tool" ] && [ -n "$2" ]; then
    TOOL="${SCRIPT_DIR}/mcp_tools/$2"
    shift 2
    if [ -x "$TOOL" ]; then
        exec "$TOOL" "$@"
    else
        echo "Herramienta no encontrada: $2"
        exit 1
    fi
fi
if [ "$1" = "--plan" ] && [ -n "$2" ]; then
    exec "$SCRIPT_DIR/sec-agent" "$@"
fi
exec "$SCRIPT_DIR/sec-agent" "$@"
