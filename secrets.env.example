# Configuración del Agente de Seguridad Perimetral
API_ENV=production
SECRET_KEY=tu_clave_secreta_aqui_para_firmar_tokens
DATABASE_URL=sqlite:///src/data/memory.db

# Credenciales de Administración por defecto para Nginx (.htpasswd)
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=coloca_aqui_el_hash_de_tu_password

# Contraseña en texto plano para Basic Auth (usada por remote_deploy.sh y security_audit.sh)
BASIC_AUTH_PASS=cambia_esta_contraseña
