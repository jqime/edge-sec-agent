#!/bin/bash
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
BACKUP_BASE="${EDGE_BACKUP_DIR:-$PROJECT_ROOT/backups}"
BACKUP_DIR="$BACKUP_BASE/mcp-$(date +%Y%m%d_%H%M%S)"
mkdir -p "$BACKUP_DIR"
cp -r /etc/ssh "$BACKUP_DIR/" 2>/dev/null
cp -r /etc/ufw "$BACKUP_DIR/" 2>/dev/null
cp /etc/fail2ban/jail.local "$BACKUP_DIR/" 2>/dev/null || true
cp /etc/fail2ban/jail.d/* "$BACKUP_DIR/" 2>/dev/null || true
cp "$PROJECT_ROOT/data/history.db" "$BACKUP_DIR/" 2>/dev/null || true
echo "✅ Respaldo completado en $BACKUP_DIR"
# Opcional: comprimir y limpiar backups antiguos
tar -czf "$BACKUP_DIR.tar.gz" "$BACKUP_DIR" && rm -rf "$BACKUP_DIR"
find "$BACKUP_BASE" -name "*.tar.gz" -mtime +7 -delete
