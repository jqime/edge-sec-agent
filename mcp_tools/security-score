#!/bin/bash
SCORE=100
if [ "$(ufw status 2>/dev/null | grep -c 'Status: active')" -eq 0 ]; then SCORE=$((SCORE-20)); fi
if [ "$(systemctl is-active fail2ban 2>/dev/null)" != "active" ]; then SCORE=$((SCORE-15)); fi
if [ "$(grep -c '^PermitRootLogin yes' /etc/ssh/sshd_config 2>/dev/null)" -gt 0 ]; then SCORE=$((SCORE-25)); fi
if [ "$(grep -c '^PasswordAuthentication yes' /etc/ssh/sshd_config 2>/dev/null)" -gt 0 ]; then SCORE=$((SCORE-15)); fi
echo "🔐 Puntuación de seguridad: $SCORE/100"
