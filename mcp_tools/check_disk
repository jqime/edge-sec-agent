#!/bin/bash
set -euo pipefail
ROOT_DIR="/root/edge-sec-agent"
SECRETS="$ROOT_DIR/secrets.env"
[ -f "$SECRETS" ] && source "$SECRETS" 2>/dev/null || true
parse_percent() { echo "$1" | tr -d '%' | tr -d ' '; }
ROOT_USAGE=$(df -P / | awk 'NR==2 {print $5}' 2>/dev/null || echo "")
HOME_USAGE=0
[ -d "/home" ] && HOME_USAGE=$(df -P /home | awk 'NR==2 {print $5}' 2>/dev/null || echo "")
ROOT_USAGE_N=$(parse_percent "$ROOT_USAGE")
HOME_USAGE_N=$(parse_percent "$HOME_USAGE")
echo "Root /: ${ROOT_USAGE_N:-0}%, /home: ${HOME_USAGE_N:-0}%"
if [ "${ROOT_USAGE_N:-0}" -ge 80 ] || [ "${HOME_USAGE_N:-0}" -ge 80 ]; then
    MSG="ALERTA: Alto uso de disco. Raíz /: ${ROOT_USAGE_N:-0}%, /home: ${HOME_USAGE_N:-0}%."
    command -v /usr/local/bin/telegram-notify.sh >/dev/null && /usr/local/bin/telegram-notify.sh "$MSG" 2>/dev/null || echo "[WARN] Telegram no disponible" >&2
fi
exit 0
