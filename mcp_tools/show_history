#!/bin/bash
set -euo pipefail
DB="/root/edge-sec-agent/data/history.db"
[ ! -f "$DB" ] && { echo "No history available"; exit 0; }
if [ "${1:-}" = "--json" ]; then
    if command -v sqlite3 >/dev/null; then
        sqlite3 -json "$DB" "SELECT timestamp, score, ssh_failures, open_ports, cpu_temp, ram_percent FROM metrics ORDER BY id DESC LIMIT 30;"
    else echo "sqlite3 no disponible"; fi
else
    sqlite3 -header -column "$DB" "SELECT timestamp, score, ssh_failures, open_ports, cpu_temp, ram_percent FROM metrics ORDER BY id DESC LIMIT 30;"
fi
